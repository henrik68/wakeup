msgid "Same for all alarms (system setting)."
msgstr "Samme for alle alarmer (systemindstilling)."

#: qml/EditPage.qml:301 qml/SettingsPage.qml:22
msgid "%1 min."
msgstr "%1 min."

#: qml/EditPage.qml:317
