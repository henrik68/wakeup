msgid "Starts quiet and reaches full volume after:"
msgstr "Starter stille og når fuld lydstyrke efter:"

#: qml/EditPage.qml:280
msgid "30 s"
msgstr "30 sek."

#: qml/EditPage.qml:280
msgid "1 min"
msgstr "1 min"

#: qml/EditPage.qml:281
