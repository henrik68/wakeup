msgid "Weekend"
msgstr "Weekend"

#: qml/Main.qml:92
msgid "%1 min"
msgstr "%1 min"

#: qml/Main.qml:93
msgid "%1 h %2 min"
msgstr "%1 t %2 min"

#: qml/SettingsPage.qml:47
msgid ""
"Could not reach the system alarm service, so these settings can't be changed "
"right now."
msgstr ""
"Kunne ikke få forbindelse til systemets alarmtjeneste, så indstillingerne "
"kan ikke ændres lige nu."

#: qml/SettingsPage.qml:54
msgid "These settings apply to all alarms, also in the Clock app."
msgstr "Disse indstillinger gælder for alle alarmer, også i Ur-appen."

#: qml/SettingsPage.qml:74
msgid "Alarm ring time"
msgstr "Alarmen ringer i"

#: qml/SettingsPage.qml:86
msgid "After this the alarm snoozes by itself."
msgstr "Derefter snoozer alarmen af sig selv."

#: qml/SettingsPage.qml:87
msgid ""
"When the ring time is made longer, WakeUp makes its rising sounds longer too "
"(about 20 seconds per sound, while WakeUp is open)."
msgstr ""
"Når ringetiden gøres længere, gør WakeUp også sine lyde med stigning længere "
"(ca. 20 sekunder pr. lyd, mens WakeUp er åben)."

#: qml/SettingsPage.qml:92
msgid "Alarm volume"
msgstr "Alarmens lydstyrke"

#: qml/SettingsPage.qml:111
msgid "Vibrate"
msgstr "Vibrer"

#: qml/SoundPage.qml:18
msgid "Stop"
msgstr "Stop"

#: qml/SoundPage.qml:40
msgid "Tap a sound to hear it."
msgstr "Tryk på en lyd for at høre den."
