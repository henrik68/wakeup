#: qml/EditPage.qml:227
msgid "Alarm"
msgstr "Sveglia"

#: qml/AlarmsPage.qml:123
msgid "No alarms yet"
msgstr "Ancora nessuna sveglia"

#: qml/AlarmsPage.qml:130
msgid "Tap + to add an alarm."
msgstr "Tocca + per aggiungere una sveglia."

#: qml/EditPage.qml:22
msgid "Edit alarm"
msgstr "Modifica sveglia"

#: qml/EditPage.qml:26
msgid "Save"
msgstr "Salva"

#: qml/EditPage.qml:76
msgid "Could not make the rising sound."
msgstr "Impossibile creare il suono progressivo."

#: qml/EditPage.qml:104
msgid "Could not save the alarm (error %1)."
msgstr "Impossibile salvare la sveglia (errore %1)."

#: qml/EditPage.qml:177
msgid "Repeat"
msgstr "Ripeti"

#: qml/EditPage.qml:214 qml/Main.qml:64
msgid "Once"
msgstr "Una volta"

#: qml/EditPage.qml:215 qml/Main.qml:66
msgid "Weekdays"
msgstr "Giorni feriali"

#: qml/EditPage.qml:216 qml/Main.qml:65
msgid "Every day"
msgstr "Ogni giorno"

#: qml/EditPage.qml:227
msgid "Description"
msgstr "Descrizione"

#: qml/EditPage.qml:236 qml/SoundPage.qml:14
msgid "Sound"
msgstr "Suono"

#: qml/EditPage.qml:251
msgid "Slowly rising volume"
msgstr "Volume progressivo"

#: qml/EditPage.qml:272
msgid "Starts quiet and reaches full volume after:"
msgstr "Inizia piano e raggiunge il volume massimo dopo:"

#: qml/EditPage.qml:280
msgid "30 s"
msgstr "30 s"

#: qml/EditPage.qml:280
msgid "1 min"
msgstr "1 min"

#: qml/EditPage.qml:281
msgid "2 min"
msgstr "2 min"

#: qml/EditPage.qml:281
msgid "5 min"
msgstr "5 min"

#: qml/EditPage.qml:297 qml/SettingsPage.qml:63
msgid "Snooze length"
msgstr "Durata posticipo"

#: qml/EditPage.qml:298
msgid "Same for all alarms (system setting)."
msgstr "Uguale per tutte le sveglie (impostazione di sistema)."

#: qml/EditPage.qml:301 qml/SettingsPage.qml:22
msgid "%1 min."
msgstr "%1 min"

#: qml/EditPage.qml:317
msgid "Preparing the rising sound…"
msgstr "Preparazione del suono progressivo…"

#: qml/EditPage.qml:336
msgid "Delete alarm"
msgstr "Elimina sveglia"

#: qml/Main.qml:67
msgid "Weekend"
msgstr "Fine settimana"

#: qml/Main.qml:92
msgid "%1 min"
msgstr "%1 min"

#: qml/Main.qml:93
msgid "%1 h %2 min"
msgstr "%1 h %2 min"

#: qml/SettingsPage.qml:47
msgid ""
"Could not reach the system alarm service, so these settings can't be changed "
"right now."
msgstr ""
"Impossibile contattare il servizio sveglie di sistema, quindi queste "
"impostazioni non possono essere modificate ora."

#: qml/SettingsPage.qml:54
msgid "These settings apply to all alarms, also in the Clock app."
msgstr ""
"Queste impostazioni valgono per tutte le sveglie, anche nell'app Orologio."

#: qml/SettingsPage.qml:74
msgid "Alarm ring time"
msgstr "Durata della suoneria"

#: qml/SettingsPage.qml:86
msgid "After this the alarm snoozes by itself."
msgstr "Dopo, la sveglia viene posticipata da sola."

#: qml/SettingsPage.qml:87
msgid ""
"When the ring time is made longer, WakeUp makes its rising sounds longer too "
"(about 20 seconds per sound, while WakeUp is open)."
msgstr ""
"Quando la durata della suoneria viene allungata, WakeUp allunga anche i suoi "
"suoni progressivi (circa 20 secondi per suono, mentre WakeUp è aperto)."

#: qml/SettingsPage.qml:92
msgid "Alarm volume"
msgstr "Volume della sveglia"

#: qml/SettingsPage.qml:111
msgid "Vibrate"
msgstr "Vibrazione"

#: qml/SoundPage.qml:18
msgid "Stop"
msgstr "Ferma"

#: qml/SoundPage.qml:40
msgid "Tap a sound to hear it."
msgstr "Tocca un suono per ascoltarlo."
