#: qml/AlarmsPage.qml:14
msgid "Alarms"
msgstr "Sveglie"

#: qml/AlarmsPage.qml:18 qml/EditPage.qml:22
msgid "New alarm"
msgstr "Nuova sveglia"

#: qml/AlarmsPage.qml:23 qml/SettingsPage.qml:17
msgid "Settings"
msgstr "Impostazioni"

#: qml/AlarmsPage.qml:38
msgid "Next alarm in %1"
msgstr "Prossima sveglia tra %1"

#: qml/AlarmsPage.qml:39
msgid "No alarm is on"
msgstr "Nessuna sveglia attiva"

#: qml/AlarmsPage.qml:85
msgid "Delete"
msgstr "Elimina"

