#: qml/AlarmsPage.qml:14
msgid "Alarms"
msgstr "Wecker"

#: qml/AlarmsPage.qml:18 qml/EditPage.qml:22
msgid "New alarm"
msgstr "Neuer Wecker"

#: qml/AlarmsPage.qml:23 qml/SettingsPage.qml:17
msgid "Settings"
msgstr "Einstellungen"

#: qml/AlarmsPage.qml:38
msgid "Next alarm in %1"
msgstr "Nächster Wecker in %1"

#: qml/AlarmsPage.qml:39
msgid "No alarm is on"
msgstr "Kein Wecker ist an"

#: qml/AlarmsPage.qml:85
msgid "Delete"
msgstr "Löschen"

#: qml/AlarmsPage.qml:98 qml/EditPage.qml:41 qml/EditPage.qml:95
#: qml/EditPage.qml:227
msgid "Alarm"
msgstr "Wecker"

#: qml/AlarmsPage.qml:123
msgid "No alarms yet"
msgstr "Noch keine Wecker"

#: qml/AlarmsPage.qml:130
msgid "Tap + to add an alarm."
msgstr "Tippe auf +, um einen Wecker hinzuzufügen."

#: qml/EditPage.qml:22
msgid "Edit alarm"
msgstr "Wecker bearbeiten"

#: qml/EditPage.qml:26
msgid "Save"
msgstr "Speichern"

#: qml/EditPage.qml:76
msgid "Could not make the rising sound."
msgstr "Der ansteigende Ton konnte nicht erstellt werden."

#: qml/EditPage.qml:104
msgid "Could not save the alarm (error %1)."
msgstr "Der Wecker konnte nicht gespeichert werden (Fehler %1)."

#: qml/EditPage.qml:177
msgid "Repeat"
msgstr "Wiederholen"

#: qml/EditPage.qml:214 qml/Main.qml:64
msgid "Once"
msgstr "Einmal"

#: qml/EditPage.qml:215 qml/Main.qml:66
msgid "Weekdays"
msgstr "Wochentags"

#: qml/EditPage.qml:216 qml/Main.qml:65
msgid "Every day"
msgstr "Jeden Tag"

#: qml/EditPage.qml:227
msgid "Description"
msgstr "Beschreibung"

#: qml/EditPage.qml:236 qml/SoundPage.qml:14
msgid "Sound"
msgstr "Ton"

#: qml/EditPage.qml:251
msgid "Slowly rising volume"
msgstr "Langsam ansteigende Lautstärke"

#: qml/EditPage.qml:272
msgid "Starts quiet and reaches full volume after:"
msgstr "Beginnt leise und erreicht volle Lautstärke nach:"

#: qml/EditPage.qml:280
msgid "30 s"
msgstr "30 s"

#: qml/EditPage.qml:280
msgid "1 min"
msgstr "1 Min."

#: qml/EditPage.qml:281
msgid "2 min"
msgstr "2 Min."

#: qml/EditPage.qml:281
msgid "5 min"
msgstr "5 Min."

#: qml/EditPage.qml:297 qml/SettingsPage.qml:63
msgid "Snooze length"
msgstr "Schlummerdauer"

#: qml/EditPage.qml:298
msgid "Same for all alarms (system setting)."
msgstr "Gilt für alle Wecker (Systemeinstellung)."

#: qml/EditPage.qml:301 qml/SettingsPage.qml:22
msgid "%1 min."
msgstr "%1 Min."

#: qml/EditPage.qml:317
msgid "Preparing the rising sound…"
msgstr "Ansteigender Ton wird vorbereitet…"

#: qml/EditPage.qml:336
msgid "Delete alarm"
msgstr "Wecker löschen"

#: qml/Main.qml:67
msgid "Weekend"
msgstr "Wochenende"

#: qml/Main.qml:92
msgid "%1 min"
msgstr "%1 Min."

#: qml/Main.qml:93
msgid "%1 h %2 min"
msgstr "%1 Std. %2 Min."

#: qml/SettingsPage.qml:47
msgid ""
"Could not reach the system alarm service, so these settings can't be changed "
"right now."
msgstr ""
"Der Weckdienst des Systems ist nicht erreichbar, daher können diese "
"Einstellungen gerade nicht geändert werden."

#: qml/SettingsPage.qml:54
msgid "These settings apply to all alarms, also in the Clock app."
msgstr "Diese Einstellungen gelten für alle Wecker, auch in der Uhr-App."

#: qml/SettingsPage.qml:74
msgid "Alarm ring time"
msgstr "Klingeldauer"

#: qml/SettingsPage.qml:86
msgid "After this the alarm snoozes by itself."
msgstr "Danach schlummert der Wecker von selbst."

#: qml/SettingsPage.qml:87
msgid ""
"When the ring time is made longer, WakeUp makes its rising sounds longer too "
"(about 20 seconds per sound, while WakeUp is open)."
msgstr ""
"Wenn die Klingeldauer verlängert wird, verlängert WakeUp auch seine "
"ansteigenden Töne (etwa 20 Sekunden pro Ton, solange WakeUp geöffnet ist)."

#: qml/SettingsPage.qml:92
msgid "Alarm volume"
msgstr "Wecker-Lautstärke"

#: qml/SettingsPage.qml:111
msgid "Vibrate"
msgstr "Vibrieren"

#: qml/SoundPage.qml:18
msgid "Stop"
msgstr "Stopp"

#: qml/SoundPage.qml:40
msgid "Tap a sound to hear it."
msgstr "Tippe auf einen Ton, um ihn anzuhören."
